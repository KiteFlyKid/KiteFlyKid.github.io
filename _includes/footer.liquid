{% capture footer_contents %}
  &copy; Copyright {{ site.time | date: '%Y' }}
  {{ site.first_name }}
  {{ site.middle_name }}
  {{ site.last_name }}. {{ site.footer_text }}
  {% if site.impressum_path %}
    <a href="{{ site.url }}{{ site.baseurl }}{{ site.impressum_path }}">Impressum</a>.
  {% endif %}
  {% if site.last_updated %}
    Last updated: {{ 'now' | date: '%B %d, %Y' }}.
  {% endif %}
{% endcapture %}

<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom mt-5{% endif %}" role="contentinfo">
  {% unless site.footer_fixed %}
    {% if site.newsletter.enabled %}
      {% if site.plugins contains 'al_newsletter' %}
        {% include plugins/al_newsletter_form_center.liquid %}
      {% else %}
        {% include newsletter.liquid center=true %}
      {% endif %}
    {% endif %}
  {% endunless %}

  <div class="container{% if site.footer_fixed %} mt-0{% endif %}">
    {% unless site.footer_fixed %}
      {% if site.mapmyvisitors_id and site.mapmyvisitors_id != '' %}
        <section class="visitor-map" aria-label="Map of website visitors">
          <h2>Visitors</h2>
          <div class="visitor-map-widget">
            <a href="{{ site.mapmyvisitors_stats_url | escape }}" title="Visit tracker">
              <img
                src="https://mapmyvisitors.com/map.png?cl=ffffff&amp;w=500&amp;t=n&amp;d={{ site.mapmyvisitors_id | uri_escape }}"
                alt="Map showing visitors to Shang Ma's website"
                width="500"
              >
            </a>
          </div>
        </section>
      {% endif %}
    {% endunless %}
    {{ footer_contents }}
  </div>
</footer>
